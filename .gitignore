# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables — every variant is ignored, and the template is the one
# exception. Listing them one by one used to leave .env.development, .env.test
# and anything else a tool invents free to be committed with real keys in it.
.env*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
*.db
*.sqlite3

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Local caches and temporary workspaces
.pnpm-store/
.pytest_cache/
.ruff_cache/
.test-tmp/
.tmp/
.tmp_*/
tmp_*/
*.tsbuildinfo
.vercel/

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# Local Windows deployment helpers
*.bat
