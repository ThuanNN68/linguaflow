.git
.gitignore
.env
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.test-tmp/
.tmp/
.pnpm-store/
*.log
docs/
eval/
*.md
!requirements.txt
.dockerignore
Dockerfile
docker-compose.yml

# The backend image runs `COPY . .`, so anything not excluded here ships with it.
# The Next.js frontend is deployed separately (see docs/operations/deployment.md) and its
# node_modules alone is larger than the rest of the image.
frontend/
node_modules/
# Local database and uploaded files — the deployed instance keeps its own on a
# mounted volume, and baking a dev copy in would overwrite nothing but confuse
# everything.
data/
tests/
.github/
