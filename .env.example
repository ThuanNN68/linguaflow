# LinguaFlow backend configuration
# Copy to .env and replace placeholder values. Never commit real secrets.

# Application
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-random-secret-generated-for-this-environment
FRONTEND_URL=http://localhost:3000
PUBLIC_FRONTEND_ORIGIN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public domains used by the production Caddy stack
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
CORS_ORIGIN_REGEX=

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://linguaflow:linguaflow@127.0.0.1:5432/linguaflow
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=900
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_READINESS_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# Translation and assistant LLM
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ASSISTANT_LLM_PROVIDER=
ASSISTANT_LLM_MODEL=

# Embeddings and retrieval
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
EMBEDDING_FALLBACK_PROVIDER=local
ASSISTANT_EMBEDDING_PROVIDER=
ASSISTANT_EMBEDDING_MODEL=
ASSISTANT_RERANK_ENABLED=true
SEMANTIC_GLOSSARY_ENABLED=true
RAG_CONTEXT_ENABLED=false

# Voice transcription
STT_PROVIDER=gemini
STT_MODEL=gemini-3.5-transcribe
STT_FALLBACK_PROVIDER=openai
STT_FALLBACK_MODEL=gpt-4o-mini-transcribe
STT_TIMEOUT_SECONDS=60
STT_RETRY_ATTEMPTS=3

# Realtime and background work
REDIS_URL=
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCAN_INTERVAL_SECONDS=60

# Attachments: local in development; choose Supabase or any S3-compatible store in production
ATTACHMENT_STORAGE_BACKEND=auto
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=20971520
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
ATTACHMENT_PRESIGN_TTL_SECONDS=300

# Server-side TTS fallback for browsers without Web Speech API
TTS_PROVIDER=disabled
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_TIMEOUT_SECONDS=30
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
GOOGLE_TTS_API_KEY=

# PWA Web Push. Generate a VAPID key pair; keep the private key server-only.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Signed outbound webhooks (managed from the admin API)
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Authentication integrations
GOOGLE_OAUTH_CLIENT_ID=

# Transactional email. Use memory only in development/test.
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LinguaFlow
SMTP_USE_TLS=true

# Optional realtime calls
RTC_PROVIDER=disabled
DAILY_API_KEY=

# Optional observability
OBSERVABILITY_PROVIDER=none
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=linguaflow
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_ENABLED=false
OTEL_SERVICE_NAME=linguaflow-api
# Full OTLP/HTTP traces endpoint, for example http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs. Keep real tokens out of source control.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACE_SAMPLE_RATIO=0.1

# Privacy-sensitive unofficial translation fallback
FALLBACK_TRANSLATOR_ENABLED=false

# Advanced tuning — defaults are suitable for most deployments. Uncomment or
# change a value only when the environment needs a deliberate override.
APP_NAME=LinguaFlow
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=1024
LLM_JUDGE_PROVIDER=
JUDGE_MODEL=
ASSISTANT_JUDGE_PROVIDER=
ASSISTANT_JUDGE_MODEL=
ASSISTANT_LLM_MAX_TOKENS=4096
ASSISTANT_RETRIEVAL_TOP_K=8
ASSISTANT_RERANK_TOP_N=4
GLOSSARY_SIMILARITY_THRESHOLD=0
RAG_TOP_K=3
TRANSLATION_TIMEOUT_SECONDS=30
FALLBACK_TRANSLATOR_TIMEOUT_SECONDS=5
SMTP_TIMEOUT_SECONDS=20
DAILY_API_BASE=https://api.daily.co/v1
CALL_RING_TIMEOUT_SECONDS=45
CALL_TOKEN_TTL_SECONDS=3600
AGENT_CONTEXT_SIZE=5
CHROMA_PERSIST_DIR=./data/chroma
